---
import Base from "../layouts/Base.astro";
import { infoPath } from "../lib/info-pages.ts";
---
<Base title="Wrong door" description="That page does not exist here." canonical={false}>
  <main class="wrap not-found" id="main">
    <p class="nf-code">404</p>
    <h1>Wrong door.</h1>
    <p class="nf-p">That page does not exist here. The skills are all in the catalog.</p>
    <p class="nf-links">
      <a class="lu lu-rest" href="/">Back to the catalog</a>
      <a class="lu lu-rest" href="https://nickneely.dev" rel="noreferrer">Or through the front door</a>
      <a class="lu lu-rest" href={infoPath("contact")}>Report a broken link</a>
    </p>
  </main>
</Base>
