---
import Base from "../layouts/Base.astro";
import { INFO_PAGES, infoMarkdownPath, longDate, type InfoPage } from "../lib/info-pages.ts";
import { renderPageMarkdown } from "../lib/markdown.ts";
import { infoData } from "../lib/structured-data.ts";

export function getStaticPaths() {
  return INFO_PAGES.map((page) => ({ params: { page: page.slug }, props: { page } }));
}

interface Props {
  page: InfoPage;
}

const { page } = Astro.props;
---
<Base title={page.title} description={page.description} markdown={infoMarkdownPath(page.slug)} structuredData={infoData(page)}>
  <main class="wrap read" id="main">
    <h1 class="title">{page.title}</h1>
    {page.updated && <p class="read-meta">Last updated <time datetime={page.updated}>{longDate(page.updated)}</time></p>}
    <div class="prose read-body" set:html={renderPageMarkdown(page.body())} />
  </main>
</Base>
