#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT

expect_invalid() {
  local fixture=$1
  local expected=$2
  if node "$repo/scripts/validate-skills.mjs" "$repo/tests/fixtures/$fixture" \
    >"$temporary/stdout" 2>"$temporary/stderr"; then
    printf 'Invalid fixture unexpectedly passed: %s\n' "$fixture" >&2
    exit 1
  fi
  grep -Fq "$expected" "$temporary/stderr"
}

expect_invalid malformed-layout 'Malformed skill layout'
expect_invalid malformed-frontmatter 'Malformed YAML frontmatter line'
expect_invalid wrong-name 'Skill name must match directory'
expect_invalid unknown-frontmatter-key 'Unknown frontmatter key'
expect_invalid unexpected-skill-subdirectory 'Unexpected skill subdirectory'
expect_invalid broken-skill-root-reference 'Broken <skill-root> reference'
expect_invalid em-dash-found 'Em dash found'
expect_invalid hardcoded-skill-install-path 'Hardcoded skill-install path'
expect_invalid readme-skill-list-mismatch 'README Skills section'

# Windows does not expose POSIX executable bits through stat. The validator
# must honor the portable mode recorded by Git instead of the working tree.
mode_fixture="$temporary/executable-mode"
mkdir -p "$mode_fixture/skills/sample/agents" "$mode_fixture/skills/sample/scripts"
printf '%s\n' '# Skills' '' '## Skills' '' '- [`sample`](skills/sample/) - Sample.' \
  >"$mode_fixture/README.md"
printf '%s\n' '---' 'name: sample' 'description: Sample skill.' '---' '' '# Sample' \
  >"$mode_fixture/skills/sample/SKILL.md"
printf '%s\n' 'interface:' '  display_name: "Sample"' '  short_description: "Sample skill"' \
  >"$mode_fixture/skills/sample/agents/openai.yaml"
printf '%s\n' '#!/usr/bin/env node' >"$mode_fixture/skills/sample/scripts/run.mjs"
git -C "$mode_fixture" init -q
git -C "$mode_fixture" add .
git -C "$mode_fixture" update-index --chmod=+x skills/sample/scripts/run.mjs
chmod 0644 "$mode_fixture/skills/sample/scripts/run.mjs"
node "$repo/scripts/validate-skills.mjs" "$mode_fixture" >/dev/null

project="$temporary/project"
mkdir -p "$project/app/admin"
printf '{"scripts":{"dev":"next dev --port 3456"},"dependencies":{"next":"1","better-auth":"1"}}\n' \
  >"$project/package.json"
node "$repo/skills/visual-verification/scripts/detect-project.mjs" "$project" \
  >"$temporary/detect.json"
node -e '
  const result = JSON.parse(require("node:fs").readFileSync(process.argv[1]));
  if (result.framework !== "next" || result.auth.provider !== "better-auth") process.exit(1);
' "$temporary/detect.json"

(
  cd "$project"
  node "$repo/skills/visual-verification/scripts/init-config.mjs" >/dev/null
)
node -e '
  const config = JSON.parse(require("node:fs").readFileSync(process.argv[1]));
  if (!config.devServer?.startCommand || config.auth?.adapter !== "better-auth") process.exit(1);
' "$project/.agents/visual-verification.json"

node "$repo/tests/ui-evidence.test.mjs"
node "$repo/tests/implement-stack.test.mjs"
node "$repo/tests/implement-program.test.mjs"

printf 'Behavior tests passed.\n'
