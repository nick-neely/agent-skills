#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT

expect_invalid() {
  local fixture=$1
  local expected=$2
  if node "$repo/scripts/validate-skills.mjs" "$repo/tests/fixtures/$fixture" \
    >"$temporary/stdout" 2>"$temporary/stderr"; then
    printf 'Invalid fixture unexpectedly passed: %s\n' "$fixture" >&2
    exit 1
  fi
  grep -Fq "$expected" "$temporary/stderr"
}

expect_invalid malformed-layout 'Malformed skill layout'
expect_invalid malformed-frontmatter 'Malformed YAML frontmatter line'
expect_invalid wrong-name 'Skill name must match directory'
expect_invalid unknown-frontmatter-key 'Unknown frontmatter key'
expect_invalid unexpected-skill-subdirectory 'Unexpected skill subdirectory'
expect_invalid broken-skill-root-reference 'Broken <skill-root> reference'
expect_invalid em-dash-found 'Em dash found'
expect_invalid hardcoded-skill-install-path 'Hardcoded skill-install path'
expect_invalid readme-skill-list-mismatch 'README Skills section'
expect_invalid calls-user-invoked-skill 'Skill calls user-invoked skill manual'
node "$repo/scripts/validate-skills.mjs" "$repo/tests/fixtures/names-user-invoked-skill" >/dev/null

# Each documented call form is rejected on its own, so one match cannot hide a
# form the validator stopped recognizing.
call_form=0
while IFS= read -r form; do
  call_form=$((call_form + 1))
  call_fixture="$temporary/call-form-$call_form"
  cp -R "$repo/tests/fixtures/calls-user-invoked-skill" "$call_fixture"
  printf '%s\n' '---' 'name: caller' 'description: Sample skill that calls a user-invoked skill.' '---' '' \
    >"$call_fixture/skills/caller/SKILL.md"
  # A form may wrap: \n in the list below becomes a line break in the skill.
  printf '%b\n' "$form" >>"$call_fixture/skills/caller/SKILL.md"
  if node "$repo/scripts/validate-skills.mjs" "$call_fixture" >/dev/null 2>"$temporary/stderr"; then
    printf 'Call form unexpectedly passed: %s\n' "$form" >&2
    exit 1
  fi
  grep -Fq 'Skill calls user-invoked skill manual' "$temporary/stderr"
done <<'FORMS'
Call the Skill tool with "manual".
Call the Skill tool\nwith "manual".
Then call "manual" on the result.
Then call\n"manual" on the result.
Follow the `manual` skill for the rest.
Follow the\n`manual` skill for the rest.
Call the `manual` skill.
Use `manual` skill here.
Finish with $manual.
FORMS

# A user-invoked skill cannot be called even by itself.
self_fixture="$temporary/call-self"
cp -R "$repo/tests/fixtures/names-user-invoked-skill" "$self_fixture"
printf '%s\n' '' 'Call the Skill tool with "manual".' >>"$self_fixture/skills/manual/SKILL.md"
if node "$repo/scripts/validate-skills.mjs" "$self_fixture" >/dev/null 2>"$temporary/stderr"; then
  printf '%s\n' 'A user-invoked skill calling itself unexpectedly passed' >&2
  exit 1
fi
grep -Fq 'Skill calls user-invoked skill manual' "$temporary/stderr"

expect_invalid undeclared-skill-call 'Skill names undeclared skill helper'

# Each dependency rule fails on its own when the passing fixture changes in
# one place: expect_broken <error> <file> <text> <replacement>.
broken=0
expect_broken() {
  broken=$((broken + 1))
  local fixture="$temporary/broken-$broken"
  cp -R "$repo/tests/fixtures/names-user-invoked-skill" "$fixture"
  node -e '
    const fs = require("node:fs");
    const [path, from, to] = process.argv
      .slice(1)
      .map((arg) => arg.replaceAll("\\n", "\n").replaceAll("\\u00a0", "\u00a0"));
    // A checkout may carry CRLF endings; the validator reads both.
    const text = fs.readFileSync(path, "utf8").replaceAll("\r\n", "\n");
    if (!text.includes(from)) throw new Error(`fixture text not found: ${from}`);
    fs.writeFileSync(path, text.replace(from, to));
  ' "$fixture/$2" "$3" "$4"
  if node "$repo/scripts/validate-skills.mjs" "$fixture" >/dev/null 2>"$temporary/stderr"; then
    printf 'Broken dependency fixture unexpectedly passed: %s\n' "$1" >&2
    exit 1
  fi
  grep -Fq "$1" "$temporary/stderr"
}
helper_description='description: Sample model-invoked skill for a fixture.'
expect_broken 'Unknown skill dependency missing' skills/pointer/SKILL.md \
  'uses: helper manual' 'uses: helper manual missing'
expect_broken 'Declared dependency pointer is never named' skills/helper/SKILL.md \
  "$helper_description" "$helper_description\nmetadata:\n  uses: pointer"
expect_broken 'Unknown metadata key needs' skills/pointer/SKILL.md 'uses: helper' 'needs: helper'
expect_broken 'Metadata block is empty' skills/manual/SKILL.md '  requires: helper\n' ''
expect_broken 'Dependency helper is declared twice' skills/manual/SKILL.md \
  'requires: helper' 'requires: helper\n  uses: helper'
expect_broken 'Skill depends on itself' skills/helper/SKILL.md \
  "$helper_description" "$helper_description\nmetadata:\n  uses: helper"
expect_broken 'Required skills form a cycle' skills/helper/SKILL.md \
  "$helper_description" "$helper_description\nmetadata:\n  requires: manual"
expect_broken 'names a skill in this repository' skills/pointer/SKILL.md \
  'sample/tools@outside' 'sample/tools@helper'
expect_broken 'Malformed metadata line' skills/manual/SKILL.md '  requires: helper' '  Requires helper'
expect_broken 'Malformed metadata line' skills/manual/SKILL.md '  requires: helper' '  requires:helper'
# A nonbreaking space after the colon looks like a space and is not one.
expect_broken 'Malformed metadata line' skills/manual/SKILL.md '  requires: helper' '  requires:\u00a0helper'
expect_broken 'Malformed dependency' skills/pointer/SKILL.md 'uses: helper manual' 'uses: helper\u00a0manual'
expect_broken 'Duplicate metadata key requires' skills/manual/SKILL.md \
  'requires: helper' 'requires: helper\n  requires: helper'
expect_broken 'Duplicate frontmatter key metadata' skills/manual/SKILL.md \
  '  requires: helper' '  requires: helper\nmetadata:\n  uses: helper'
expect_broken 'Skill names undeclared skill helper' skills/pointer/SKILL.md 'uses: helper manual' 'uses: manual'
expect_broken 'Metadata must be a block' skills/manual/SKILL.md 'metadata:\n  requires: helper' 'metadata: helper'
expect_broken 'Metadata must be a block' skills/manual/SKILL.md \
  'metadata:\n  requires: helper' 'metadata: {requires: helper}'
expect_broken 'Malformed dependency [' skills/manual/SKILL.md 'requires: helper' 'requires: ['
expect_broken 'Malformed dependency "helper"' skills/manual/SKILL.md 'requires: helper' 'requires: "helper"'
expect_broken 'Malformed dependency ""' skills/pointer/SKILL.md 'uses: helper manual sample/tools@outside' 'uses: ""'
expect_broken 'Skill names undeclared skill extra' skills/pointer/SKILL.md '`extra()`' '`extra`'
expect_broken 'Skill names undeclared skill extra' skills/pointer/SKILL.md '`extra()`' '`/extra`'
expect_broken 'Skill names undeclared skill elsewhere' skills/pointer/SKILL.md 'a price such as $5' 'a call to $elsewhere'
expect_broken 'Declared dependency outside is never named' skills/pointer/SKILL.md '`sample/tools@outside`' 'that outside tool'
expect_broken 'Skill names undeclared skill sample/tools@outside' skills/pointer/SKILL.md \
  'uses: helper manual sample/tools@outside' 'uses: helper manual'
expect_broken 'README install table is stale' README.md '`manual helper`' '`manual`'
expect_broken 'README install table is stale' skills/pointer/SKILL.md \
  'uses: helper manual sample/tools@outside' 'requires: sample/tools@outside\n  uses: helper manual'
expect_broken 'README lacks the generated install table' README.md '<!-- install-commands:start -->' ''
expect_broken 'README has more than one install table' README.md \
  '<!-- install-commands:end -->' '<!-- install-commands:end -->\n<!-- install-commands:start -->\n<!-- install-commands:end -->'

# --write-install repairs a stale table, touches nothing outside the markers,
# and refuses to write from declarations that fail another check.
write_fixture="$temporary/write-install"
cp -R "$repo/tests/fixtures/names-user-invoked-skill" "$write_fixture"
# The first line ends in CRLF and holds a byte that is not valid UTF-8, so a
# rewrite that normalized or re-encoded the file would change bytes outside
# the table.
node -e '
  const fs = require("node:fs");
  const [path, expected] = process.argv.slice(1);
  const text = fs.readFileSync(path, "utf8").replaceAll("\r\n", "\n");
  const head = Buffer.concat([Buffer.from("caf"), Buffer.from([0xe9]), Buffer.from("\r\n")]);
  fs.writeFileSync(expected, Buffer.concat([head, Buffer.from(text)]));
  fs.writeFileSync(path, Buffer.concat([head, Buffer.from(text.replace("`manual helper`", "`manual`"))]));
' "$write_fixture/README.md" "$temporary/write-install-expected.md"
node "$repo/scripts/validate-skills.mjs" --write-install "$write_fixture" >/dev/null
cmp -s "$write_fixture/README.md" "$temporary/write-install-expected.md"
node -e '
  const fs = require("node:fs");
  const [readme, skill] = process.argv.slice(1);
  fs.writeFileSync(readme, fs.readFileSync(readme, "utf8").replace("`manual helper`", "`manual`"));
  fs.writeFileSync(skill, fs.readFileSync(skill, "utf8").replace("uses: helper", "uses: helper missing"));
' "$write_fixture/README.md" "$write_fixture/skills/pointer/SKILL.md"
if node "$repo/scripts/validate-skills.mjs" --write-install "$write_fixture" >/dev/null 2>"$temporary/stderr"; then
  printf '%s\n' 'Install table was written from failing declarations' >&2
  exit 1
fi
grep -Fq 'README install table was not written' "$temporary/stderr"
grep -Fq '| `manual` | `manual` |' "$write_fixture/README.md"
expect_invalid empty-folded-description 'Folded description requires indented content'
expect_invalid overlong-folded-description 'Frontmatter description exceeds 1024 characters'
expect_invalid quoted-overlong-folded-description 'Frontmatter description exceeds 1024 characters'
expect_invalid clipped-overlong-folded-description 'Frontmatter description exceeds 1024 characters'
expect_invalid folded-description-unknown-key 'Unknown frontmatter key'
node "$repo/scripts/validate-skills.mjs" "$repo/tests/fixtures/folded-description" >/dev/null

# Windows does not expose POSIX executable bits through stat. The validator
# must honor the portable mode recorded by Git instead of the working tree.
mode_fixture="$temporary/executable-mode"
mkdir -p "$mode_fixture/skills/sample/agents" "$mode_fixture/skills/sample/scripts"
printf '%s\n' '# Skills' '' '## Skills' '' '- [`sample`](skills/sample/) - Sample.' \
  >"$mode_fixture/README.md"
printf '%s\n' '---' 'name: sample' 'description: Sample skill.' '---' '' '# Sample' \
  >"$mode_fixture/skills/sample/SKILL.md"
printf '%s\n' 'interface:' '  display_name: "Sample"' '  short_description: "Sample skill"' \
  >"$mode_fixture/skills/sample/agents/openai.yaml"
printf '%s\n' '#!/usr/bin/env node' >"$mode_fixture/skills/sample/scripts/run.mjs"
git -C "$mode_fixture" init -q
git -C "$mode_fixture" add .
git -C "$mode_fixture" update-index --chmod=+x skills/sample/scripts/run.mjs
chmod 0644 "$mode_fixture/skills/sample/scripts/run.mjs"
node "$repo/scripts/validate-skills.mjs" "$mode_fixture" >/dev/null

# Test files have isolated temporary workspaces. Bound file-level parallelism
# so media tests can overlap without starting one worker per logical CPU.
test_jobs=${SKILLS_TEST_JOBS:-}
if [[ -z "$test_jobs" ]]; then
  test_jobs=$(node -p 'Math.min(process.platform === "darwin" ? 8 : 4, require("node:os").availableParallelism())')
fi
node --test --test-concurrency="$test_jobs" "$repo"/tests/*.test.mjs

printf 'Behavior tests passed.\n'
