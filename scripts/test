#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT

expect_invalid() {
  local fixture=$1
  local expected=$2
  if node "$repo/scripts/validate-skills.mjs" "$repo/tests/fixtures/$fixture" \
    >"$temporary/stdout" 2>"$temporary/stderr"; then
    printf 'Invalid fixture unexpectedly passed: %s\n' "$fixture" >&2
    exit 1
  fi
  grep -Fq "$expected" "$temporary/stderr"
}

expect_invalid malformed-layout 'Malformed skill layout'
expect_invalid malformed-frontmatter 'Malformed YAML frontmatter line'
expect_invalid wrong-name 'Skill name must match directory'
expect_invalid unknown-frontmatter-key 'Unknown frontmatter key'
expect_invalid unexpected-skill-subdirectory 'Unexpected skill subdirectory'
expect_invalid broken-skill-root-reference 'Broken <skill-root> reference'
expect_invalid em-dash-found 'Em dash found'
expect_invalid hardcoded-skill-install-path 'Hardcoded skill-install path'
expect_invalid readme-skill-list-mismatch 'README Skills section'
expect_invalid calls-user-invoked-skill 'Skill calls user-invoked skill manual'
node "$repo/scripts/validate-skills.mjs" "$repo/tests/fixtures/names-user-invoked-skill" >/dev/null

# Each documented call form is rejected on its own, so one match cannot hide a
# form the validator stopped recognizing.
call_form=0
while IFS= read -r form; do
  call_form=$((call_form + 1))
  call_fixture="$temporary/call-form-$call_form"
  cp -R "$repo/tests/fixtures/calls-user-invoked-skill" "$call_fixture"
  printf '%s\n' '---' 'name: caller' 'description: Sample skill that calls a user-invoked skill.' '---' '' \
    >"$call_fixture/skills/caller/SKILL.md"
  # A form may wrap: \n in the list below becomes a line break in the skill.
  printf '%b\n' "$form" >>"$call_fixture/skills/caller/SKILL.md"
  if node "$repo/scripts/validate-skills.mjs" "$call_fixture" >/dev/null 2>"$temporary/stderr"; then
    printf 'Call form unexpectedly passed: %s\n' "$form" >&2
    exit 1
  fi
  grep -Fq 'Skill calls user-invoked skill manual' "$temporary/stderr"
done <<'FORMS'
Call the Skill tool with "manual".
Call the Skill tool\nwith "manual".
Then call "manual" on the result.
Then call\n"manual" on the result.
Follow the `manual` skill for the rest.
Follow the\n`manual` skill for the rest.
Call the `manual` skill.
Use `manual` skill here.
Finish with $manual.
FORMS

# A user-invoked skill cannot be called even by itself.
self_fixture="$temporary/call-self"
cp -R "$repo/tests/fixtures/names-user-invoked-skill" "$self_fixture"
printf '%s\n' '' 'Call the Skill tool with "manual".' >>"$self_fixture/skills/manual/SKILL.md"
if node "$repo/scripts/validate-skills.mjs" "$self_fixture" >/dev/null 2>"$temporary/stderr"; then
  printf '%s\n' 'A user-invoked skill calling itself unexpectedly passed' >&2
  exit 1
fi
grep -Fq 'Skill calls user-invoked skill manual' "$temporary/stderr"
expect_invalid empty-folded-description 'Folded description requires indented content'
expect_invalid overlong-folded-description 'Frontmatter description exceeds 1024 characters'
expect_invalid quoted-overlong-folded-description 'Frontmatter description exceeds 1024 characters'
expect_invalid clipped-overlong-folded-description 'Frontmatter description exceeds 1024 characters'
expect_invalid folded-description-unknown-key 'Unknown frontmatter key'
node "$repo/scripts/validate-skills.mjs" "$repo/tests/fixtures/folded-description" >/dev/null

# Windows does not expose POSIX executable bits through stat. The validator
# must honor the portable mode recorded by Git instead of the working tree.
mode_fixture="$temporary/executable-mode"
mkdir -p "$mode_fixture/skills/sample/agents" "$mode_fixture/skills/sample/scripts"
printf '%s\n' '# Skills' '' '## Skills' '' '- [`sample`](skills/sample/) - Sample.' \
  >"$mode_fixture/README.md"
printf '%s\n' '---' 'name: sample' 'description: Sample skill.' '---' '' '# Sample' \
  >"$mode_fixture/skills/sample/SKILL.md"
printf '%s\n' 'interface:' '  display_name: "Sample"' '  short_description: "Sample skill"' \
  >"$mode_fixture/skills/sample/agents/openai.yaml"
printf '%s\n' '#!/usr/bin/env node' >"$mode_fixture/skills/sample/scripts/run.mjs"
git -C "$mode_fixture" init -q
git -C "$mode_fixture" add .
git -C "$mode_fixture" update-index --chmod=+x skills/sample/scripts/run.mjs
chmod 0644 "$mode_fixture/skills/sample/scripts/run.mjs"
node "$repo/scripts/validate-skills.mjs" "$mode_fixture" >/dev/null

# Test files have isolated temporary workspaces. Bound file-level parallelism
# so media tests can overlap without starting one worker per logical CPU.
test_jobs=${SKILLS_TEST_JOBS:-}
if [[ -z "$test_jobs" ]]; then
  test_jobs=$(node -p 'Math.min(process.platform === "darwin" ? 8 : 4, require("node:os").availableParallelism())')
fi
node --test --test-concurrency="$test_jobs" "$repo"/tests/*.test.mjs

printf 'Behavior tests passed.\n'
